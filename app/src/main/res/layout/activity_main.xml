<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:orientation="vertical">

    <!-- Mode selector tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnModeWhisper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/whisper" />

        <Button
            android:id="@+id/btnModeVosk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vosk" />

        <Button
            android:id="@+id/btnModeWuw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wuw" />
    </LinearLayout>

    <!-- Whisper panel -->
    <LinearLayout
        android:id="@+id/panelWhisper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFCDD2"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:textColor="#B71C1C"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="STT is unavailable due to invalid configuration.\nCheck stt_config.json and restart the app." />

        <!-- Strategy selection (Whisper only) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strategy"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupStrategy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioManualManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Manual"
                android:checked="true" />
            <RadioButton
                android:id="@+id/radioManualAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Auto" />
        </RadioGroup>

        <!-- Whisper Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="@string/stop" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/clear" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Say something..."
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/txtDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/txtConfigDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#FFF9C4"
                    android:textColor="#33691E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Vosk panel -->
    <LinearLayout
        android:id="@+id/panelVosk"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Wake-word indicator -->
        <TextView
            android:id="@+id/txtVoskWakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#E8F5E9"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:text="[WAKE WORD DETECTED] Switching to command mode..." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vosk_mode"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/radioVoskMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioVoskNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vosk_mode_normal"
                android:checked="true" />
            <RadioButton
                android:id="@+id/radioVoskHotWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vosk_mode_hotword" />
            <RadioButton
                android:id="@+id/radioVoskWakeWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/vosk_mode_wakeword" />
        </RadioGroup>

        <!-- Vosk Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnVoskStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start" />

            <Button
                android:id="@+id/btnVoskStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/stop"
                android:enabled="false" />

            <Button
                android:id="@+id/btnVoskClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/clear" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVoskMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:background="#FFF9C4"
                    android:textColor="#F57F17"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/txtVoskOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:text="Tap Start Vosk to begin test..." />

                <TextView
                    android:id="@+id/txtVoskFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#FFF9C4"
                    android:textColor="#33691E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:textIsSelectable="true"
                    android:text="@string/vosk_final_hint" />

                <TextView
                    android:id="@+id/txtVoskConfigDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#F3E5F5"
                    android:textColor="#4A148C"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- WUW panel -->
    <LinearLayout
        android:id="@+id/panelWuw"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtWuwStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vosk_status_idle"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wake Word Mode"
            android:textStyle="bold" />

        <!-- Template list -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wuw_saved_templates"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="120dp"
            android:background="#F3E5F5"
            android:padding="4dp">

            <RadioGroup
                android:id="@+id/radioWuwTemplates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Template waveform preview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Template Waveform"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <dev.barrycade.voicecore.WuwWaveformView
            android:id="@+id/viewWuwTemplateWaveform"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:background="#1A1A2E"
            android:visibility="visible" />

        <!-- WUW Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWuwRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wuw_record" />

                <Button
                    android:id="@+id/btnWuwMatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/wuw_match"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWuwPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wuw_play"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btnWuwDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/wuw_delete"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Threshold slider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Threshold"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtWuwThreshold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.70"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/seekWuwThreshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="70" />
        </LinearLayout>

        <!-- Calibration toggle -->
        <CheckBox
            android:id="@+id/chkWuwCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wuw_show_calibration"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:checked="false" />

        <!-- Calibration panel (collapsible) -->
        <LinearLayout
            android:id="@+id/panelWuwCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp"
            android:background="#F3E5F5">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Recording duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wuw_rec_duration"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtWuwRecDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4000"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ms"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekWuwRecDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="14"
                        android:progress="6" />

                    <!-- minFramesForMatch -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_min_frames"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwMinFrames"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="27"
                            android:progress="7" />

                        <TextView
                            android:id="@+id/txtWuwMinFrames"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- maxFramesForMatch -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_max_frames"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwMaxFrames"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="40" />

                        <TextView
                            android:id="@+id/txtWuwMaxFrames"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- checkIntervalFrames -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_check_interval"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwCheckInterval"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="19"
                            android:progress="4" />

                        <TextView
                            android:id="@+id/txtWuwCheckInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- similarityK (float 0.1-2.0 mapped to 0-19) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_similarity_k"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwSimilarityK"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="19"
                            android:progress="4" />

                        <TextView
                            android:id="@+id/txtWuwSimilarityK"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.5"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- preEmphasisAlpha (float 0.0-0.99 mapped to 0-99) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_pre_emphasis"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwPreEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="99"
                            android:progress="97" />

                        <TextView
                            android:id="@+id/txtWuwPreEmphasis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.97"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- numCoefficients (dropdown: 8, 13, 20) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_num_coeffs"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <RadioGroup
                        android:id="@+id/radioWuwNumCoeffs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioWuwCoeff8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8" />

                        <RadioButton
                            android:id="@+id/radioWuwCoeff13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/radioWuwCoeff20"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20" />
                    </RadioGroup>

                    <!-- frameDurationMs (15-50, step 5 -> map to 0-7) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_frame_duration"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwFrameDuration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="7"
                            android:progress="2" />

                        <TextView
                            android:id="@+id/txtWuwFrameDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ms"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- frameStrideMs (5-20, step 5 -> map to 0-3) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wuw_frame_stride"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekWuwFrameStride"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="3"
                            android:progress="1" />

                        <TextView
                            android:id="@+id/txtWuwFrameStride"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ms"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Similarity Feedback -->
        <ProgressBar
            android:id="@+id/progressWuwSimilarity"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- Live waveform visualization (always visible) -->
        <dev.barrycade.voicecore.WuwWaveformView
            android:id="@+id/viewWuwWaveform"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:background="#1A1A2E"
            android:visibility="visible" />

        <!-- Similarity history summary (always visible) -->
        <TextView
            android:id="@+id/txtWuwSimilarityHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="4dp"
            android:background="#FFECB3"
            android:textColor="#4E342E"
            android:textSize="10sp"
            android:typeface="monospace"
            android:visibility="visible"
            android:text="" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtWuwOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:text="Tap Record to capture a wake word, then Start to listen." />

                <TextView
                    android:id="@+id/txtWuwDetection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#E8F5E9"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:text=""
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>

