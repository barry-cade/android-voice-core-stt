<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:orientation="vertical">

    <!-- Mode selector tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnModeWhisper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/whisper" />

        <Button
            android:id="@+id/btnModeVosk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vosk" />
    </LinearLayout>

    <!-- Whisper panel -->
    <LinearLayout
        android:id="@+id/panelWhisper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtWhisperStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vosk_status_idle"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFCDD2"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:textColor="#B71C1C"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="STT is unavailable due to invalid configuration.\nCheck stt_config.json and restart the app." />

        <!-- Strategy selection (Whisper only) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strategy"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupStrategy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioManualManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Manual"
                android:checked="true" />
            <RadioButton
                android:id="@+id/radioManualAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Auto" />
        </RadioGroup>

        <!-- Whisper Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="@string/stop" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/clear" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Say something..."
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/txtDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/txtConfigDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#FFF9C4"
                    android:textColor="#33691E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Vosk panel -->
    <LinearLayout
        android:id="@+id/panelVosk"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Wake-word indicator -->
        <TextView
            android:id="@+id/txtVoskWakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#E8F5E9"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:text="[WAKE WORD DETECTED] Switching to command mode..." />

        <!-- Vosk mode selection -->
        <TextView
            android:id="@+id/txtVoskStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: IDLE"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vosk_mode"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioVoskMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioVoskNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vosk_mode_normal"
                android:checked="true" />
            <RadioButton
                android:id="@+id/radioVoskHotWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vosk_mode_hotword" />
            <RadioButton
                android:id="@+id/radioVoskWakeWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vosk_mode_wakeword" />
        </RadioGroup>

        <!-- Vosk Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnVoskStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start" />

            <Button
                android:id="@+id/btnVoskStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/stop"
                android:enabled="false" />

            <Button
                android:id="@+id/btnVoskClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/clear" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVoskMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:background="#FFF9C4"
                    android:textColor="#F57F17"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/txtVoskOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:text="Tap Start Vosk to begin test..." />

                <TextView
                    android:id="@+id/txtVoskFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#FFF9C4"
                    android:textColor="#33691E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:textIsSelectable="true"
                    android:text="@string/vosk_final_hint" />

                <TextView
                    android:id="@+id/txtVoskConfigDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#F3E5F5"
                    android:textColor="#4A148C"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>

