<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtErrorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFCDD2"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="STT is unavailable due to invalid configuration.\nCheck stt_config.json and restart the app." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartManual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Manual Mode" />

        <Button
            android:id="@+id/btnStartStreaming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Start Streaming Mode" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Clear" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Stop" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Say something..."
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/txtDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="#E8EAF6"
                android:textColor="#1A237E"
                android:textSize="11sp"
                android:typeface="monospace"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/txtConfigDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="#FFF9C4"
                android:textColor="#33691E"
                android:textSize="11sp"
                android:typeface="monospace"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
