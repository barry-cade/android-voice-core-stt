<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:orientation="vertical">

    <!-- Mode selector tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnModeWhisper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Whisper" />

        <Button
            android:id="@+id/btnModeVosk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vosk" />
    </LinearLayout>

    <!-- Whisper panel -->
    <LinearLayout
        android:id="@+id/panelWhisper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFCDD2"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:textColor="#B71C1C"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="STT is unavailable due to invalid configuration.\nCheck stt_config.json and restart the app." />

        <!-- Strategy selection (Whisper only) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Strategy"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupStrategy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioManualManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Manual"
                android:checked="true" />
            <RadioButton
                android:id="@+id/radioManualAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Auto" />
        </RadioGroup>

        <!-- Whisper Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="Stop" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Clear" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Say something..."
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/txtDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/txtConfigDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#FFF9C4"
                    android:textColor="#33691E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:visibility="gone"
                    android:text="" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Vosk panel -->
    <LinearLayout
        android:id="@+id/panelVosk"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Vosk Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnVoskTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Vosk" />

            <Button
                android:id="@+id/btnVoskStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="Stop" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVoskOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:background="#E8EAF6"
                    android:textColor="#1A237E"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:text="Tap Start Vosk to begin test..." />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>

